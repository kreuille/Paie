# Déploiement automatique du workflow n8n
# Copiez ce fichier en .env et remplissez vos valeurs :
#   cp .env.example .env

# URL de base de l'API n8n (sans slash final)
N8N_URL=https://n8n.guedou.com/api/v1

# Clé API générée dans n8n → Settings → API → Create an API key
N8N_API_KEY=your_api_key_here
